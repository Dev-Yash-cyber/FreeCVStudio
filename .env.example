PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/freecvstudio?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Optional AI Provider Configuration
# When left blank or 'built-in', FreeCV Studio uses high-performance intelligent rule-based generation with zero external cost.
AI_PROVIDER=built-in
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
